# Add to the existing HTTPS server only after verifying its live configuration.
# This does not replace any existing /app, Brain, Jobs or authentication routes.
location ^~ /kelion-channel/ {
    proxy_pass http://127.0.0.1:8778/;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    client_max_body_size 256k;
    proxy_read_timeout 20s;
}

#!/usr/bin/python3
"""kelion-aproba-livrare <lucrare>   (doar root) — Adrian aprobă livrarea pe live a UNEI lucrări (22.10.2026).

Scrie aprobarea în /var/lib/kelion-livrare/aprobari.json, la «lucrari», atomic, fără să atingă aprobările existente
(«skilluri»). Coada vede aprobarea la următoarea rulare și pornește livrarea (backup, probă, rollback).
  kelion-aproba-livrare --lista     arată lucrările aprobate
"""
import json
import os
import re
import sys
import tempfile
import time

APROBARI = os.environ.get("KELION_APROBARI", "/var/lib/kelion-livrare/aprobari.json")


def main(a):
    if os.geteuid() != 0:
        print("OPRIT: doar root (Adrian) aprobă livrări."); return 1
    try:
        with open(APROBARI, encoding="utf-8") as h:
            d = json.load(h)
    except FileNotFoundError:
        d = {}
    except ValueError:
        print(f"OPRIT: {APROBARI} nu e JSON valid; nimic schimbat."); return 1
    if a == ["--lista"]:
        for k, v in sorted((d.get("lucrari") or {}).items()):
            print(k, v.get("ora", ""))
        return 0
    if len(a) != 1 or not re.fullmatch(r"\d{8}-\d{6}-[0-9a-f]{4}", a[0]):
        print("folosire: kelion-aproba-livrare <lucrare, ex. 20261022-053313-407e> | --lista"); return 2
    d.setdefault("lucrari", {})[a[0]] = {"ora": time.strftime("%Y-%m-%d %H:%M:%S"), "de": "Adrian"}
    director = os.path.dirname(APROBARI)
    fd, tmp = tempfile.mkstemp(dir=director, prefix=".aprobari-")
    with os.fdopen(fd, "w", encoding="utf-8") as h:
        json.dump(d, h, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, APROBARI)
    print(f"APROBAT: livrarea lucrarii {a[0]}; coada o porneste la urmatoarea rulare.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

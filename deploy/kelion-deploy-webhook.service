[Unit]
Description=Kelion: primește webhook-ul GitHub și pornește deploy-ul web imediat
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /usr/local/lib/kelion-deploy/webhook-receiver.mjs
Environment=SECRET_FILE=/etc/kelion-deploy/webhook-secret
Restart=always
RestartSec=3
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target

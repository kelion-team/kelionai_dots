[Unit]
Description=Kelion: primește notificarea GitHub Actions (OIDC) și pornește deploy-ul web imediat
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /usr/local/lib/kelion-deploy/webhook-receiver.mjs
Restart=always
RestartSec=3
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
